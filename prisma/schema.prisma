// =============================================================================
// Appointment System — Prisma Schema
// Stack: PostgreSQL · Prisma · Next.js 15
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum Plan {
  PAYG
  STARTER
  PRO
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ReminderChannel {
  SMS
  EMAIL
}

enum ReminderStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELLED
}

enum UsageEventType {
  SMS_SENT
  EMAIL_SENT
  SMS_FAILED
  EMAIL_FAILED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// =============================================================================
// USER  (business owner account)
// =============================================================================

model User {
  id             String    @id @default(uuid())
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  name           String
  email          String    @unique
  hashedPassword String    @map("hashed_password")

  // A user owns one business (extend to many later if needed)
  businessId     String?   @map("business_id")
  business       Business? @relation(fields: [businessId], references: [id])

  role           UserRole  @default(OWNER)

  @@map("users")
}

enum UserRole {
  OWNER
  ADMIN
}



model Business {
  id                String    @id @default(uuid())
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  name              String
  slug              String    @unique
  timezone          String    @default("Australia/Melbourne")
  logoUrl           String?   @map("logo_url")
  primaryColor      String?   @map("primary_color")
  websiteUrl        String?   @map("website_url")

  stripeCustomerId  String?   @unique @map("stripe_customer_id")
  stripeSubId       String?   @unique @map("stripe_sub_id")
  plan              Plan      @default(PAYG)
  planRenewsAt      DateTime? @map("plan_renews_at")
  creditBalance     Decimal   @default(0) @db.Decimal(10, 4) @map("credit_balance")

  bookingLeadHours  Int       @default(2)   @map("booking_lead_hours")
  bookingMaxDays    Int       @default(60)  @map("booking_max_days")
  requiresConfirm   Boolean   @default(false) @map("requires_confirm")
  allowClientCancel Boolean   @default(true)  @map("allow_client_cancel")
  cancelLeadHours   Int       @default(24)  @map("cancel_lead_hours")

  services          Service[]
  staffMembers      StaffMember[]
  clients           Client[]
  usageEvents       UsageEvent[]
  reminderTemplates ReminderTemplate[]
  users             User[]

  @@map("businesses")
}

// =============================================================================
// SERVICE
// =============================================================================

model Service {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  businessId   String   @map("business_id")
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name         String
  description  String?
  durationMins Int      @map("duration_mins")
  price        Decimal? @db.Decimal(10, 2)
  color        String?
  isActive     Boolean  @default(true) @map("is_active")

  staffServices StaffService[]
  appointments  Appointment[]

  @@map("services")
}

// =============================================================================
// STAFF MEMBER
// =============================================================================

model StaffMember {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name       String
  email      String
  phone      String?
  avatarUrl  String?  @map("avatar_url")
  isActive   Boolean  @default(true) @map("is_active")

  calendarCredentials Json? @map("calendar_credentials")

  staffServices      StaffService[]
  availabilityRules  AvailabilityRule[]
  blockedTimes       BlockedTime[]
  appointments       Appointment[]

  @@unique([businessId, email])
  @@map("staff_members")
}

model StaffService {
  staffMemberId String      @map("staff_member_id")
  serviceId     String      @map("service_id")
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffMemberId, serviceId])
  @@map("staff_services")
}

// =============================================================================
// AVAILABILITY
// =============================================================================

model AvailabilityRule {
  id            String      @id @default(uuid())
  staffMemberId String      @map("staff_member_id")
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  dayOfWeek     DayOfWeek   @map("day_of_week")
  startTime     String      @map("start_time")
  endTime       String      @map("end_time")

  @@map("availability_rules")
}

model BlockedTime {
  id            String      @id @default(uuid())
  staffMemberId String      @map("staff_member_id")
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  startsAt      DateTime    @map("starts_at")
  endsAt        DateTime    @map("ends_at")
  reason        String?

  @@map("blocked_times")
}

// =============================================================================
// CLIENT
// =============================================================================

model Client {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name       String
  email      String
  phone      String?
  notes      String?

  appointments Appointment[]

  @@unique([businessId, email])
  @@map("clients")
}

// =============================================================================
// APPOINTMENT
// =============================================================================

model Appointment {
  id            String            @id @default(uuid())
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  serviceId     String            @map("service_id")
  service       Service           @relation(fields: [serviceId], references: [id])

  staffMemberId String            @map("staff_member_id")
  staffMember   StaffMember       @relation(fields: [staffMemberId], references: [id])

  clientId      String            @map("client_id")
  client        Client            @relation(fields: [clientId], references: [id])

  startsAt      DateTime          @map("starts_at")
  endsAt        DateTime          @map("ends_at")
  status        AppointmentStatus @default(PENDING)

  icalUid       String            @unique @default(uuid()) @map("ical_uid")
  clientNotes   String?           @map("client_notes")
  priceSnapshot Decimal?          @db.Decimal(10, 2) @map("price_snapshot")

  cancelledAt   DateTime?         @map("cancelled_at")
  cancelledBy   String?           @map("cancelled_by")

  reminders     Reminder[]

  @@index([startsAt])
  @@index([staffMemberId, startsAt])
  @@map("appointments")
}

// =============================================================================
// REMINDER TEMPLATE
// =============================================================================

model ReminderTemplate {
  id           String          @id @default(uuid())
  businessId   String          @map("business_id")
  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  channel      ReminderChannel
  offsetMins   Int             @map("offset_mins")
  subject      String?
  bodyTemplate String          @map("body_template")
  isActive     Boolean         @default(true) @map("is_active")

  @@map("reminder_templates")
}

// =============================================================================
// REMINDER
// =============================================================================

model Reminder {
  id            String          @id @default(uuid())
  createdAt     DateTime        @default(now()) @map("created_at")

  appointmentId String          @map("appointment_id")
  appointment   Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  channel       ReminderChannel
  offsetMins    Int             @map("offset_mins")
  scheduledFor  DateTime        @map("scheduled_for")
  status        ReminderStatus  @default(SCHEDULED)

  jobId         String?         @map("job_id")
  renderedBody  String?         @map("rendered_body")
  renderedSubject String?       @map("rendered_subject")
  providerMsgId String?         @map("provider_msg_id")
  failureReason String?         @map("failure_reason")
  firedAt       DateTime?       @map("fired_at")

  usageEvents   UsageEvent[]

  @@index([scheduledFor])
  @@map("reminders")
}

// =============================================================================
// USAGE EVENT
// =============================================================================

model UsageEvent {
  id          String         @id @default(uuid())
  createdAt   DateTime       @default(now()) @map("created_at")

  businessId  String         @map("business_id")
  business    Business       @relation(fields: [businessId], references: [id])

  reminderId  String?        @map("reminder_id")
  reminder    Reminder?      @relation(fields: [reminderId], references: [id])

  eventType   UsageEventType @map("event_type")
  cost        Decimal        @db.Decimal(10, 4)
  baseRate    Decimal        @db.Decimal(10, 4) @map("base_rate")

  stripeUsageRecordId String? @map("stripe_usage_record_id")

  @@index([businessId, createdAt])
  @@map("usage_events")
}
