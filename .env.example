# =============================================================================
# Appointment System — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
#
# IMPORTANT: Do NOT wrap values in quotes unless the value contains spaces.
# Stripe keys, Redis URLs, and webhook secrets must have NO quotes.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/appt_system?sslmode=require

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=your-generated-secret-here
NEXTAUTH_URL=http://localhost:3000

# ── Stripe ────────────────────────────────────────────────────────────────────
# NO QUOTES — quotes cause signature verification failures
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Run: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# Secret changes each time you run stripe login — update if you re-authenticate
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...

# ── Mobile Message (SMS) ──────────────────────────────────────────────────────
MOBILEMESSAGE_USERNAME=your-api-username
MOBILEMESSAGE_PASSWORD=your-api-password
MOBILEMESSAGE_SENDER_ID=

# ── Resend (Email) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=bookings@appti.net
RESEND_FROM_NAME=Appti

# ── Redis — NO QUOTES, note the double-s in rediss:// for TLS ────────────────
REDIS_URL=rediss://default:yourpassword@your-endpoint.upstash.io:6379

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Appti

# ── Pricing (server-side, used by worker) ────────────────────────────────────
RATE_SMS_PAYG=0.120
RATE_SMS_STARTER=0.080
RATE_SMS_PRO=0.060
RATE_EMAIL_PAYG=0.0050
RATE_EMAIL_STARTER=0.0030
RATE_EMAIL_PRO=0.0020

# ── Pricing (client-side, used in UI) ────────────────────────────────────────
NEXT_PUBLIC_RATE_SMS_PAYG=0.120
NEXT_PUBLIC_RATE_SMS_STARTER=0.080
NEXT_PUBLIC_RATE_SMS_PRO=0.060
NEXT_PUBLIC_RATE_EMAIL_PAYG=0.0050
NEXT_PUBLIC_RATE_EMAIL_STARTER=0.0030
NEXT_PUBLIC_RATE_EMAIL_PRO=0.0020
NEXT_PUBLIC_BUNDLE_SMS_STARTER=150
NEXT_PUBLIC_BUNDLE_EMAIL_STARTER=500
NEXT_PUBLIC_BUNDLE_SMS_PRO=500
NEXT_PUBLIC_BUNDLE_EMAIL_PRO=2000
BUNDLE_SMS_STARTER=150
BUNDLE_EMAIL_STARTER=500
BUNDLE_SMS_PRO=500
BUNDLE_EMAIL_PRO=2000
